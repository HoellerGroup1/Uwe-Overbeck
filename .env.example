# Kopie als .env.local anlegen und ausfüllen. .env.local ist in .gitignore.

# Resend API-Key (https://resend.com/api-keys)
RESEND_API_KEY=

# Absenderadresse. Muss eine bei Resend verifizierte Domain sein.
KONTAKT_ABSENDER="Website Uwe Overbeck <website@example.com>"

# Empfängeradresse für Beratungsanfragen.
KONTAKT_EMPFAENGER=
